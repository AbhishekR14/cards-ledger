<?xml version="1.0" encoding="utf-8"?>
<!-- A dialog grows into place from slightly smaller while it fades in. -->
<set xmlns:android="http://schemas.android.com/apk/res/android" android:interpolator="@android:interpolator/decelerate_cubic" android:shareInterpolator="true">
  <scale android:fromXScale="0.9" android:toXScale="1" android:fromYScale="0.9" android:toYScale="1"
      android:pivotX="50%" android:pivotY="50%" android:duration="240" />
  <alpha android:fromAlpha="0" android:toAlpha="1" android:duration="180" />
</set>
